{
  "name": "iway-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
