# Server-only configuration. Copy to .env.local; never commit populated values.
# Requires Node >=20.12.0. Existing deployment/CI environment takes precedence.
# Keep each name exactly once. Omit DATABASE_URL entirely for local file preview.
PORT=4173
NODE_ENV=development
DATABASE_URL=
PGSSL=require
# Actual approved consent-notice version; no placeholder approval is implied.
IWAY_CONSENT_VERSION=

# Opt-in certification only. Keep disabled until login and authorization are checked.
# Uses separate credentials; never falls back to DATABASE_URL or an admin/API key.
IWAY_PG_TEST_OPT_IN=0
IWAY_PG_TEST_URL=
IWAY_PG_TEST_HOST=
IWAY_PG_TEST_CONSENT_VERSION=
